# Copy to .env.local and fill in.

# --- Required ---
# Supabase project URL (Settings > API)
SHARED_SUPABASE_URL=
# Supabase service role key. Server only, never in the browser
SHARED_SUPABASE_SERVICE_ROLE_KEY=
# The password you sign in with
PROJECTS_OWNER_PASSWORD=
# Long random string that signs the sign-in cookie
PROJECTS_OWNER_SECRET=
# AWS access key with Amazon Bedrock access, for the mayor
BEDROCK_ACCESS_KEY_ID=
# Its secret
BEDROCK_SECRET_ACCESS_KEY=

# --- Optional ---
# AWS region for Bedrock, e.g. ap-southeast-2
BEDROCK_REGION=
# Bedrock model id override for the mayor
BEHAVE_MODEL_ID=
# Long random token your devices send to /projects/behave/api/ingest
BEHAVE_INGEST_TOKEN=
